# Copy to the repository root before starting the stack: cp deploy/.env.example .env
APP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Optional: comma-separated browser origins allowed to call the API; defaults to PUBLIC_ORIGIN.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

POSTGRES_DB=uniride_unistay
POSTGRES_USER=uniride
POSTGRES_PASSWORD=change-me

# The password inside DATABASE_URL must be URL-encoded (@ becomes %40, etc.).
DATABASE_URL=postgres://uniride:change-me@db:5432/uniride_unistay
DATABASE_SSL=false

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

FARE_BASE=1000
FARE_PER_KM=700
FARE_MIN=1500
FARE_ROUND_TO=100
COMMISSION_RATE=0.12
ACCOMMODATION_SUCCESS_FEE_RATE=0.07
DRIVER_HEARTBEAT_TIMEOUT_MINUTES=5

# Leave empty when nginx serves the API on the same origin; set an absolute URL only if the API lives elsewhere.
NEXT_PUBLIC_API_URL=
